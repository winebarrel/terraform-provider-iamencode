{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnedObjectsOverTls13",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::example-bucket",
        "arn:aws:s3:::example-bucket/*"
      ],
      "Condition": {
        "StringEquals": {"s3:ResourceAccount": "123456789012"},
        "NumericGreaterThanEquals": {"s3:TlsVersion": 1.2},
        "Bool": {"aws:SecureTransport": "true"}
      }
    },
    {
      "Sid": "EnforceSseKmsOnPut",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::example-bucket/*",
      "Condition": {
        "StringNotEquals": {"s3:x-amz-server-side-encryption": "aws:kms"}
      }
    }
  ]
}
