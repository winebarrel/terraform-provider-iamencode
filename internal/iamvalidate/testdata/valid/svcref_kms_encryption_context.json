{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptOnlyViaS3WithEncryptionContext",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:Encrypt"
      ],
      "Resource": "arn:aws:kms:ap-northeast-1:123456789012:key/abcd1234-ab12-cd34-ef56-1234567890ab",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "123456789012",
          "kms:ViaService": "s3.ap-northeast-1.amazonaws.com",
          "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::example-bucket"
        },
        "ForAllValues:StringEquals": {
          "kms:EncryptionContextKeys": [
            "aws:s3:arn"
          ]
        }
      }
    }
  ]
}
